#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Restart the dock so the plugin disappears cleanly.
    if command -v systemctl >/dev/null 2>&1; then
        if [ -n "${SUDO_USER}" ]; then
            su - "${SUDO_USER}" -c "systemctl --user restart dde-shell@DDE.service" >/dev/null 2>&1 || true
        elif [ -n "${USER}" ]; then
            systemctl --user restart dde-shell@DDE.service >/dev/null 2>&1 || true
        fi
    fi
fi

exit 0
